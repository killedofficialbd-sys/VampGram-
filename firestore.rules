rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isFounder() {
      return signedIn()
        && request.auth.token.email == 'killedofficialbd@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function activeUser() {
      // Older Vampgram user documents do not contain accountStatus.
      // Missing status means active; only an explicit suspended value blocks access.
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'suspended');
    }
    function isMember(members) { return activeUser() && members is list && request.auth.uid in members; }
    function conversationMember(conversationId) {
      return activeUser()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && (
          (('members' in get(/databases/$(database)/documents/conversations/$(conversationId)).data)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members)
          || (('participants' in get(/databases/$(database)/documents/conversations/$(conversationId)).data)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          || (('userIds' in get(/databases/$(database)/documents/conversations/$(conversationId)).data)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.userIds)
          || (('memberIds' in get(/databases/$(database)/documents/conversations/$(conversationId)).data)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds)
        );
    }
    function mediaParent(mediaId) { return get(/databases/$(database)/documents/media/$(mediaId)).data; }
    function canReadMedia(mediaId) {
      return activeUser()
        && exists(/databases/$(database)/documents/media/$(mediaId))
        && (mediaParent(mediaId).kind == 'avatar'
          || (mediaParent(mediaId).kind == 'story')
          || (mediaParent(mediaId).kind == 'post')
          || request.auth.uid in mediaParent(mediaId).members);
    }
    function canWriteMedia(mediaId) {
      return activeUser()
        && exists(/databases/$(database)/documents/media/$(mediaId))
        && ((mediaParent(mediaId).kind == 'avatar' && mediaParent(mediaId).ownerId == request.auth.uid)
          || (mediaParent(mediaId).kind == 'story' && mediaParent(mediaId).ownerId == request.auth.uid)
          || (mediaParent(mediaId).kind == 'post' && mediaParent(mediaId).ownerId == request.auth.uid)
          || (mediaParent(mediaId).kind == 'attachment' && mediaParent(mediaId).senderId == request.auth.uid));
    }
    function validFounderField() {
      return !('isFounder' in request.resource.data)
        || request.resource.data.isFounder == false
        || (request.resource.data.isFounder == true && isFounder());
    }
    function validReadAt() {
      return !('readAt' in request.resource.data)
        || (request.resource.data.readAt is map
          && request.resource.data.readAt.keys().hasOnly(resource.data.members)
          && ((!('readAt' in resource.data)
            && request.resource.data.readAt.keys().hasOnly([request.auth.uid]))
            || (('readAt' in resource.data)
              && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid]))));
    }
    function validTyping() {
      return !('typing' in request.resource.data)
        || (request.resource.data.typing is map
          && request.resource.data.typing.keys().hasOnly(resource.data.members)
          && ((!('typing' in resource.data)
            && request.resource.data.typing.keys().hasOnly([request.auth.uid]))
            || (('typing' in resource.data)
              && request.resource.data.typing.diff(resource.data.typing).affectedKeys().hasOnly([request.auth.uid]))));
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if isFounder();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','displayName','username','photoURL','bio','statusText','isFounder','createdAt','updatedAt','lastSeen'])
        && validFounderField();
      allow update: if (isOwner(uid)
          && (!('uid' in resource.data) || resource.data.uid == uid)
          && request.resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','displayName','username','photoURL','bio','statusText','isFounder','updatedAt','lastSeen'])
          && validFounderField())
        || (isFounder()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus','adminNote','adminUpdatedAt']));
      allow delete: if false;
      match /chatPrefs/{conversationId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['hidden','clearedAt','updatedAt'])
          && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
        allow delete: if isOwner(uid);
      }
    }

    match /privateUsers/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email','phone','createdAt','updatedAt']);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','phone','updatedAt']);
      allow delete: if false;
    }

    match /userLookup/{lookupId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','kind','value'])
        && request.resource.data.kind == 'email'
        && request.auth.token.email != null
        && request.resource.data.value == request.auth.token.email.lower();
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || isFounder()
          || (('members' in resource.data) && request.auth.uid in resource.data.members)
          || (('participants' in resource.data) && request.auth.uid in resource.data.participants)
          || (('userIds' in resource.data) && request.auth.uid in resource.data.userIds)
          || (('memberIds' in resource.data) && request.auth.uid in resource.data.memberIds));
      // Preserve visibility of private chats from all released Vampgram schemas.
      allow list: if isFounder()
        || (signedIn() && (
          (('members' in resource.data) && request.auth.uid in resource.data.members)
          || (('participants' in resource.data) && request.auth.uid in resource.data.participants)
          || (('userIds' in resource.data) && request.auth.uid in resource.data.userIds)
          || (('memberIds' in resource.data) && request.auth.uid in resource.data.memberIds)
        ));
      allow create: if activeUser() && isMember(request.resource.data.members)
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && request.resource.data.type in ['direct','group']
        && ((request.resource.data.type == 'direct' && request.resource.data.members.size() == 2)
          || (request.resource.data.type == 'group'
            && request.resource.data.groupName is string
            && request.resource.data.groupName.size() >= 1
            && request.resource.data.groupName.size() <= 48))
        && request.resource.data.keys().hasOnly(['members','type','groupName','memberProfiles','lastMessage','updatedAt','unread','readAt','typing','createdAt']);
      allow update: if activeUser() && isMember(resource.data.members)
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','unread','memberProfiles','readAt','typing','groupName'])
        && validReadAt()
        && validTyping();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if conversationMember(conversationId);
        allow create: if conversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId','senderName','senderIsFounder','type','text','attachment','replyTo','createdAt'])
          && request.resource.data.senderIsFounder == isFounder()
          && request.resource.data.type in ['text','image','video','audio','file']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
        allow update: if conversationMember(conversationId)
          && ((resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions is map
              && ((!('reactions' in resource.data)
                  && request.resource.data.reactions.keys().hasOnly([request.auth.uid]))
                || (('reactions' in resource.data)
                  && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))))); 
        allow delete: if conversationMember(conversationId) && resource.data.senderId == request.auth.uid;
      }
    }

    match /calls/{callId} {
      allow get: if isMember(resource.data.members);
      allow list: if signedIn() && resource.data.calleeId == request.auth.uid;
      allow create: if activeUser()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.calleeId in request.resource.data.members
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['audio','video'];
      allow update: if activeUser() && isMember(resource.data.members)
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status','updatedAt']);
      allow delete: if false;
      match /candidates/{candidateId} {
        allow read: if isMember(get(/databases/$(database)/documents/calls/$(callId)).data.members);
        allow create: if isMember(get(/databases/$(database)/documents/calls/$(callId)).data.members)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['from','candidate','createdAt']);
        allow update, delete: if false;
      }
    }

    match /media/{mediaId} {
      allow get: if activeUser()
        && (!exists(/databases/$(database)/documents/media/$(mediaId))
          || resource.data.kind == 'avatar'
          || resource.data.kind == 'story'
          || resource.data.kind == 'post'
          || request.auth.uid in resource.data.members);
      allow list: if false;
      allow create: if activeUser()
        && ((request.resource.data.kind == 'avatar'
              && request.resource.data.ownerId == request.auth.uid
              && request.resource.data.contentType is string
              && request.resource.data.contentType.matches('image/.*')
              && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 512000
              && request.resource.data.totalChunks is int && request.resource.data.totalChunks > 0 && request.resource.data.totalChunks <= 3
              && request.resource.data.keys().hasOnly(['kind','ownerId','contentType','size','totalChunks','createdAt','updatedAt']))
          || (request.resource.data.kind == 'story'
              && request.resource.data.ownerId == request.auth.uid
              && request.resource.data.contentType is string
              && request.resource.data.contentType.matches('(image/.*|video/.*)')
              && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 4194304
              && request.resource.data.totalChunks is int && request.resource.data.totalChunks > 0 && request.resource.data.totalChunks <= 16
              && request.resource.data.keys().hasOnly(['kind','ownerId','contentType','size','totalChunks','createdAt','updatedAt']))
          || (request.resource.data.kind == 'post'
              && request.resource.data.ownerId == request.auth.uid
              && request.resource.data.contentType is string
              && request.resource.data.contentType.matches('(image/.*|video/.*)')
              && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 4194304
              && request.resource.data.totalChunks is int && request.resource.data.totalChunks > 0 && request.resource.data.totalChunks <= 16
              && request.resource.data.keys().hasOnly(['kind','ownerId','contentType','size','totalChunks','createdAt','updatedAt']))
          || (request.resource.data.kind == 'attachment'
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.members is list
              && request.resource.data.members.size() >= 2
              && request.resource.data.members.size() <= 50
              && request.auth.uid in request.resource.data.members
              && request.resource.data.recipientId in request.resource.data.members
              && request.resource.data.conversationId is string
              && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
              && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.members.hasAll(request.resource.data.members)
              && request.resource.data.contentType is string
              && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 6291456
              && request.resource.data.totalChunks is int && request.resource.data.totalChunks > 0 && request.resource.data.totalChunks <= 24
              && request.resource.data.name is string && request.resource.data.name.size() <= 120
              && request.resource.data.keys().hasOnly(['kind','senderId','recipientId','members','conversationId','name','contentType','size','totalChunks','createdAt','updatedAt'])));
      allow update: if activeUser()
        && resource.data.kind == 'avatar'
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.kind == 'avatar'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.contentType is string
        && request.resource.data.contentType.matches('image/.*')
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 512000
        && request.resource.data.totalChunks is int && request.resource.data.totalChunks > 0 && request.resource.data.totalChunks <= 3
        && request.resource.data.keys().hasOnly(['kind','ownerId','contentType','size','totalChunks','createdAt','updatedAt']);
      allow delete: if signedIn()
        && ((resource.data.kind == 'avatar' && resource.data.ownerId == request.auth.uid)
          || (resource.data.kind == 'story' && resource.data.ownerId == request.auth.uid)
          || (resource.data.kind == 'post' && resource.data.ownerId == request.auth.uid)
          || (resource.data.kind == 'attachment' && resource.data.senderId == request.auth.uid));
      match /chunks/{chunkId} {
        allow get, list: if canReadMedia(mediaId);
        allow create: if canWriteMedia(mediaId)
          && request.resource.data.keys().hasOnly(['index','data','createdAt'])
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 450000
          && request.resource.data.index < mediaParent(mediaId).totalChunks;
        allow update: if false;
        allow delete: if canWriteMedia(mediaId);
      }
    }

    match /stories/{storyId} {
      allow get, list: if signedIn();
      allow create: if activeUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerIsFounder == isFounder()
        && request.resource.data.keys().hasOnly(['ownerId','ownerName','ownerUsername','ownerIsFounder','text','imageDataUrl','mediaId','mediaType','mediaName','createdAt','expiresAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && ((!('mediaId' in request.resource.data) && request.resource.data.imageDataUrl is string && request.resource.data.imageDataUrl.size() <= 450000)
          || (request.resource.data.mediaId is string && request.resource.data.mediaId.size() > 5
            && request.resource.data.mediaType is string
            && exists(/databases/$(database)/documents/media/$(request.resource.data.mediaId))
            && get(/databases/$(database)/documents/media/$(request.resource.data.mediaId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/media/$(request.resource.data.mediaId)).data.kind == 'story'));
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isFounder();
      match /views/{uid} {
        allow get, list: if activeUser()
          && (get(/databases/$(database)/documents/stories/$(storyId)).data.ownerId == request.auth.uid
            || request.auth.uid == uid || isFounder());
        allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['viewerId','viewedAt']) && request.resource.data.viewerId == uid;
        allow update, delete: if false;
      }
    }

    match /channels/{channelId} {
      allow get, list: if signedIn();
      allow create: if activeUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members is list
        && (!('admins' in request.resource.data)
          || (request.resource.data.admins is list
            && request.resource.data.admins.size() == 1
            && request.resource.data.admins[0] == request.auth.uid))
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 48
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.keys().hasOnly(['title','description','ownerId','admins','members','createdAt','updatedAt']);
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','updatedAt','members','admins']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','updatedAt'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /posts/{postId} {
        allow get, list: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members;
        allow create: if signedIn()
          && (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid
            || (('admins' in get(/databases/$(database)/documents/channels/$(channelId)).data)
              && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.admins))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 3000
          && request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt']);
        allow update: if signedIn()
          && (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid
            || (('admins' in get(/databases/$(database)/documents/channels/$(channelId)).data)
              && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.admins))
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
        allow delete: if signedIn()
          && (get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid
            || (('admins' in get(/databases/$(database)/documents/channels/$(channelId)).data)
              && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.admins));
      }
    }


    // Public social feed. Media is stored in Firestore chunks, owned by the author.
    match /feedPosts/{postId} {
      allow get, list: if activeUser();
      allow create: if activeUser()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.authorIsFounder == isFounder()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 3000
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0
        && request.resource.data.keys().hasOnly(['authorId','authorName','authorUsername','authorPhoto','authorIsFounder','text','mediaId','mediaType','mediaName','likes','createdAt','updatedAt'])
        && (!('mediaId' in request.resource.data) || request.resource.data.mediaId == null
          || (request.resource.data.mediaId is string
            && exists(/databases/$(database)/documents/media/$(request.resource.data.mediaId))
            && get(/databases/$(database)/documents/media/$(request.resource.data.mediaId)).data.kind == 'post'
            && get(/databases/$(database)/documents/media/$(request.resource.data.mediaId)).data.ownerId == request.auth.uid));
      allow update: if activeUser() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','updatedAt'])
          && request.resource.data.likes is list
          && ((request.resource.data.likes.size() == resource.data.likes.size() + 1
              && request.auth.uid in request.resource.data.likes
              && !(request.auth.uid in resource.data.likes)
              && request.resource.data.likes.hasAll(resource.data.likes))
            || (request.resource.data.likes.size() == resource.data.likes.size() - 1
              && !(request.auth.uid in request.resource.data.likes)
              && request.auth.uid in resource.data.likes
              && resource.data.likes.hasAll(request.resource.data.likes)))));
      allow delete: if activeUser() && (resource.data.authorId == request.auth.uid || isFounder());
      match /comments/{commentId} {
        allow get, list: if activeUser();
        allow create: if activeUser()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt']);
        allow update: if false;
        allow delete: if activeUser() && (resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/feedPosts/$(postId)).data.authorId == request.auth.uid
          || isFounder());
      }
      match /likes/{uid} {
        allow get, list: if activeUser();
        allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['uid','createdAt']) && request.resource.data.uid == uid;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    match /communities/{communityId} {
      allow get, list: if activeUser();
      allow create: if activeUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 48
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['name','description','ownerId','members','createdAt','updatedAt']);
      allow update: if activeUser() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','updatedAt']))
        || (request.auth.uid != resource.data.ownerId
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','updatedAt']))
        || (request.auth.uid != resource.data.ownerId
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','updatedAt'])));
      allow delete: if activeUser() && (resource.data.ownerId == request.auth.uid || isFounder());
      match /posts/{postId} {
        allow get, list: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.members;
        allow create: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.members
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt']);
        allow update: if false;
        allow delete: if activeUser() && (resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid
          || isFounder());
      }
    }

    match /users/{uid}/savedPosts/{postId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.postId == postId
        && request.resource.data.keys().hasOnly(['postId','createdAt'])
        && exists(/databases/$(database)/documents/feedPosts/$(postId));
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /notifications/{uid}/items/{notificationId} {
      allow get, list: if isOwner(uid);
      allow create: if activeUser()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid == uid
        && uid != request.auth.uid
        && request.resource.data.type in ['like','comment','follow']
        && request.resource.data.postId is string
        && request.resource.data.keys().hasOnly(['recipientUid','actorUid','actorName','type','postId','preview','read','createdAt']);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow delete: if isOwner(uid);
    }

    // User follow graph. Private outgoing list + readable follower mirror for profile counts.
    match /follows/{uid}/following/{targetUid} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid)
        && targetUid != uid
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && request.resource.data.followerUid == uid
        && request.resource.data.targetUid == targetUid
        && request.resource.data.keys().hasOnly(['followerUid','targetUid','createdAt']);
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /followers/{targetUid}/users/{followerUid} {
      allow get, list: if activeUser();
      allow create: if activeUser()
        && followerUid == request.auth.uid
        && targetUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(targetUid))
        && request.resource.data.followerUid == followerUid
        && request.resource.data.targetUid == targetUid
        && request.resource.data.keys().hasOnly(['followerUid','targetUid','createdAt']);
      allow delete: if activeUser() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if activeUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['reporterId','targetUid','reason','status','createdAt']);
      allow get: if isFounder() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow list: if isFounder();
      allow update: if isFounder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt','closedBy']);
      allow delete: if isFounder();
    }

    match /adminLogs/{logId} {
      allow get, list: if isFounder();
      allow create: if isFounder()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['actorUid','actorEmail','action','targetUid','details','createdAt']);
      allow update, delete: if false;
    }
  }
}
